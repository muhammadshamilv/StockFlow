# Copy to .env.development.local to override locally
# API base path (proxied to Django by Vite in dev)
VITE_API_URL=/api/v1
# Where the Vite dev proxy forwards /api and /media
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
VITE_APP_NAME=StockFlow
# Show the "Try a demo account" buttons on the login page (portfolio mode)
VITE_SHOW_DEMO_LOGINS=true
