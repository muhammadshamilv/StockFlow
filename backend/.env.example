# ---------------------------------------------------------------
# StockFlow backend environment – copy to .env and fill in values
#   cp .env.example .env
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# ---------------------------------------------------------------

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://stockflow_user:stockflow123@localhost:5432/stockflow_db

# Frontend origin (Vite dev server)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Cookies: keep False on http://localhost, True in production (HTTPS)
AUTH_COOKIE_SECURE=False

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
JWT_REMEMBER_ME_DAYS=30

# Email: console in dev. For Gmail SMTP in prod:
# EMAIL_URL=smtp+tls://you@gmail.com:app-password@smtp.gmail.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=StockFlow <no-reply@stockflow.dev>

TIME_ZONE=Asia/Kolkata

# Business
STOCKFLOW_CURRENCY=INR
STOCKFLOW_INVOICE_PREFIX=INV
STOCKFLOW_COMPANY_NAME=StockFlow Retail Pvt. Ltd.
STOCKFLOW_COMPANY_ADDRESS=MG Road, Kochi, Kerala 682016
STOCKFLOW_COMPANY_GSTIN=32ABCDE1234F1Z5
STOCKFLOW_DEFAULT_TAX_RATE=18
